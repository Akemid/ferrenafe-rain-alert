---
// Static page: no server, no build-time fetch. `contracts/public-snapshot.json`
// is fetched from `/data/status.json` in the browser, once per visit, by the
// module script below — a build-time fetch would make every publish cycle
// require a redeploy (design 2026-09-21, "The site").
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Alertas de lluvia — Ferreñafe</title>
		<!-- `is:global`, and the whole block, deliberately.

		     Astro's default is to scope a component's styles by rewriting every
		     selector to require a generated attribute
		     (`.status-level[data-astro-cid-lcdefpme]`) and adding that attribute
		     at build time to the elements written in THIS template. Every
		     element `src/lib/page.ts` builds with `document.createElement` —
		     the level heading, the degraded notice, the staleness banner — has
		     no such attribute, so those rules matched nothing and a live
		     `riesgo inminente` was served in plain black body text. The full
		     account is in
		     `docs/blog/2026-09-28-two-tests-checked-both-ends-and-the-middle-was-missing.md`.

		     Scoping is bought to stop one component's styles reaching another.
		     This site is one page with one component, so it isolates nothing
		     here, and it has already cost a mute alarm in production.

		     The block is global as a whole rather than split into a scoped part
		     and a global part. A split works, but it puts a standing question on
		     every future rule — "is the element this paints written in the
		     template or created by `page.ts`?" — answered correctly today and
		     wrongly the day someone moves an element between them. One rule with
		     no exceptions cannot be got wrong that way.

		     `test/built-styles.test.ts` asserts this against the built output,
		     because the transform in question exists nowhere else. -->
		<style is:global>
			/* Horizontal gutter shared by every band, so the bands stay full-bleed
				while their content lines up. From 48rem the gutter grows with the
				viewport so content stays within 70rem, centred, as one column: the
				history lives outside `#status` and `#status` is an aria-live region,
				so neither is restructured for width. */
			:root {
				--pad-x: 20px;
			}
			body {
				margin: 0;
				background: #fff;
				color: #1b1b1b;
				font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
				font-size: 18px;
				line-height: 1.45;
			}
			h1 {
				margin: 0;
				padding: 18px var(--pad-x);
				background: #1f2d36;
				color: #fff;
				font-size: 21px;
				font-weight: 700;
				line-height: 1.2;
			}

			/* --- Status: summary (label, scale, level, caveat, time) --- */
			.status-summary {
				padding: 22px var(--pad-x) 20px;
				border-bottom: 1px solid #d6d5d0;
			}
			.status-label {
				margin: 0;
				font-size: 14px;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: #3a3a38;
			}

			/* The scale. Colour is one of two signals; the other is `aria-current`
				on the current segment. */
			.scale {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 6px;
				margin: 12px 0 0;
				padding: 0;
				list-style: none;
			}
			.scale-segment {
				min-width: 0;
			}
			.scale-bar {
				display: block;
				box-sizing: border-box;
				height: 18px;
				background: #e6e5e1;
			}
			.scale-label {
				display: block;
				margin-top: 6px;
				font-size: 13px;
				font-weight: 500;
				line-height: 1.2;
				color: #4a4a48;
			}
			.scale-segment.is-current .scale-label {
				font-weight: 800;
				color: #1b1b1b;
			}
			.scale-segment.is-current.segment-none .scale-bar {
				background: #1a7f37;
			}
			.scale-segment.is-current.segment-prepare .scale-bar {
				background: #e0a800;
			}
			.scale-segment.is-current.segment-imminent .scale-bar {
				background: #b3121f;
			}
			/* A "sin riesgo" from a cycle that could not read every source is not
				an all-clear, so its segment is hatched grey, not green. `prepare`
				and `imminent` keep their own colours: an incomplete cycle that still
				found risk is telling the truth about the risk it found. */
			/* The current marker: a dark border so the bar is not identified by
			   colour alone, and so a pale fill (#e0a800 is 2.15:1 on white) still
			   meets 3:1 against the page. */
			.scale-segment.is-current .scale-bar {
				border: 2px solid #1b1b1b;
			}
			/* The modifiers carry the extra `.scale` ancestor so they beat the
			   level fills and the marker border by specificity, not by coming
			   later in the file. Reordering these rules must not turn a stale or
			   incomplete "none" green. */
			.scale .scale-segment.is-current.scale-hatched .scale-bar {
				background: repeating-linear-gradient(-45deg, #6b6b68 0 6px, #e6e5e1 6px 12px);
			}
			/* Nothing was read: no segment is current, every bar is an empty dashed
				outline. */
			.scale-blind .scale-bar {
				background: #fff;
				border: 2px dashed #6b6b68;
			}
			/* Stale: outline only, no level colour. Declared after the fills above
				and equally specific, so it wins. */
			.scale .scale-segment.is-current.scale-outlined .scale-bar {
				background: #fff;
				border: 3px solid #3a3a38;
			}

			.status-level {
				margin: 18px 0 0;
				font-size: 36px;
				font-weight: 800;
				line-height: 1.08;
				color: #1b1b1b;
				text-wrap: balance;
			}
			.status-level::first-letter {
				text-transform: uppercase;
			}
			.level-none .status-level {
				color: #1a7f37;
			}
			.level-prepare .status-level {
				color: #7a5000;
			}
			.level-imminent .status-level {
				color: #b3121f;
			}
			/* A "sin riesgo" from a cycle that could not read every source is not an
				all-clear, so it must not be painted with the green one. Two classes
				beat one on specificity, so this wins over `.level-none .status-level`
				above. `prepare` and `imminent` keep their own colours, as on the
				scale. */
			.status-degraded.level-none .status-level {
				color: #1b1b1b;
			}
			.status-blind .status-level {
				color: #1b1b1b;
			}
			/* Stale drops the level colour: a two-day-old "sin riesgo" in green
				reads as a current all-clear. */
			.status-stale .status-level {
				color: #3a3a38;
			}
			/* Not italic small print. This sentence qualifies the level above it,
				and a resident who skips it reads a reassurance the cycle did not
				earn. */
			.degraded-notice {
				margin: 12px 0 0;
				font-weight: 700;
				color: #1b1b1b;
			}
			.status-evaluated {
				margin: 14px 0 0;
				font-size: 16px;
				font-variant-numeric: tabular-nums;
				color: #3a3a38;
			}

			/* The staleness banner: a full-width band above the level. */
			.stale-warning {
				margin: 0;
				padding: 16px var(--pad-x);
				background: #1b1b1b;
				color: #ffd84d;
				font-size: 19px;
				font-weight: 700;
			}

			/* --- Status: details (alert, reasons) --- */
			.status-details {
				display: flex;
				flex-direction: column;
				gap: 16px;
				padding: 20px var(--pad-x);
			}
			.no-alert {
				margin: 0;
				font-weight: 600;
			}
			.alert-box {
				padding: 16px;
				background: #f4f3ef;
			}
			.alert-title {
				margin: 0;
				font-size: 19px;
				font-weight: 800;
				line-height: 1.25;
			}
			.alert-body {
				margin: 10px 0 0;
				font: inherit;
				font-size: 16px;
				white-space: pre-wrap;
			}
			.reasons-title {
				margin: 0 0 6px;
				font-weight: 700;
			}
			.reasons {
				display: flex;
				flex-direction: column;
				gap: 6px;
				margin: 0;
				padding-left: 22px;
			}

			/* --- Failed fetch --- */
			.status-error {
				padding: 24px var(--pad-x);
				background: #f4f3ef;
				border-bottom: 3px solid #1b1b1b;
				font-size: 20px;
				font-weight: 700;
				color: #1b1b1b;
			}
			.status-error p {
				margin: 0;
			}

			/* --- Loading: a skeleton of the scale, replaced by `renderPage` --- */
			.loading,
			.noscript-notice {
				padding: 22px var(--pad-x);
			}
			.noscript-notice {
				margin: 0;
			}
			.skeleton-scale {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 6px;
			}
			.skeleton-bar {
				height: 18px;
				background: #ececea;
			}
			.loading-text {
				margin: 14px 0 0;
				font-size: 20px;
				font-weight: 600;
				color: #3a3a38;
			}

			/* --- Sent alerts --- */
			#recent-alerts {
				padding: 20px var(--pad-x);
				background: #f4f3ef;
			}
			#recent-alerts h2 {
				margin: 0 0 8px;
				font-size: 19px;
			}
			#recent-alerts-list {
				display: flex;
				flex-direction: column;
				gap: 8px;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			#recent-alerts-list li {
				padding: 10px 12px;
				background: #fff;
				font-size: 16px;
			}
			.recent-date {
				font-weight: 700;
				font-variant-numeric: tabular-nums;
			}
			#recent-alerts-empty,
			#recent-alerts-error {
				margin: 0;
				font-size: 16px;
				color: #1b1b1b;
			}

			@media (min-width: 48rem) {
				:root {
					--pad-x: max(56px, calc((100vw - 70rem) / 2 + 56px));
				}
				h1 {
					font-size: 28px;
				}
				.scale,
				.skeleton-scale {
					gap: 10px;
				}
				.scale-bar,
				.skeleton-bar {
					height: 24px;
				}
				.scale-label {
					font-size: 16px;
				}
				.status-level {
					font-size: 60px;
					line-height: 1;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Alertas de lluvia — Ferreñafe</h1>

			<section id="status" aria-live="polite">
				<div id="status-loading" class="loading">
					<div class="skeleton-scale" aria-hidden="true">
						<span class="skeleton-bar"></span>
						<span class="skeleton-bar"></span>
						<span class="skeleton-bar"></span>
					</div>
					<p class="loading-text">Cargando el estado actual…</p>
				</div>
				<!-- Without this, a missing bundle or a browser with scripting
				     off leaves "Cargando el estado actual…" on screen forever:
				     it fails in the right direction but never resolves. The
				     inline style hides the loading line so the two messages do
				     not contradict each other. It hides the whole loading block, skeleton
				     included. -->
				<noscript>
					<style>
						#status-loading {
							display: none;
						}
					</style>
					<p class="noscript-notice">
						Esta página necesita JavaScript para mostrar el estado actual. Actívelo en
						su navegador y vuelva a cargar la página. Si no puede, comuníquese con
						Defensa Civil.
					</p>
				</noscript>
			</section>

			<section id="recent-alerts">
				<h2>Alertas enviadas</h2>
				<ul id="recent-alerts-list"></ul>
				<p id="recent-alerts-empty" hidden>No se ha enviado ninguna alerta todavía.</p>
				<p id="recent-alerts-error" hidden>No se pudo cargar el historial de alertas enviadas.</p>
			</section>
		</main>

		<script>
			import { parseSnapshot } from '../lib/snapshot';
			import { resolveViewState, type FetchOutcome } from '../lib/view';
			import { renderPage, type PageElements } from '../lib/page';

			const STATUS_URL = '/data/status.json';

			const elements: PageElements = {
				status: document.getElementById('status') as HTMLElement,
				recentList: document.getElementById('recent-alerts-list') as HTMLUListElement,
				recentEmpty: document.getElementById('recent-alerts-empty') as HTMLElement,
				recentError: document.getElementById('recent-alerts-error') as HTMLElement,
			};

			async function load(): Promise<void> {
				let outcome: FetchOutcome;
				try {
					const response = await fetch(STATUS_URL, { cache: 'no-store' });
					if (!response.ok) {
						throw new Error(`status endpoint responded with ${response.status}`);
					}
					const raw: unknown = await response.json();
					outcome = { ok: true, snapshot: parseSnapshot(raw) };
				} catch (error) {
					console.error('failed to load /data/status.json', error);
					outcome = { ok: false, error };
				}

				renderPage(elements, resolveViewState(outcome, new Date()));
			}

			load();
		</script>
	</body>
</html>
