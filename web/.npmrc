# No dependency of this site needs to run code at install time, and an
# install script is the cheapest way for a compromised package anywhere in the
# tree to execute on a developer's machine or in CI.
#
# This replaces an `allowScripts` key in `package.json`, which is
# `@lavamoat/allow-scripts` configuration. lavamoat is not a dependency here,
# so npm ignored that key entirely and every install script still ran: a field
# that reads as a supply-chain control while being inert is worse than no
# field at all.
#
# Verified rather than assumed, because esbuild (a transitive dependency of
# astro/vite) does declare a `postinstall`: a clean `npm ci` with this setting,
# followed by `astro build`, completes successfully — esbuild resolves its
# platform binary through its 26 optionalDependencies, not through the script.
#
# `npm test`, `npm run build` and the other explicit `npm run` invocations are
# unaffected; npm only suppresses lifecycle scripts.
ignore-scripts=true
