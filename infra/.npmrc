# This tree runs with CloudFormation deploy credentials. An install script is
# the cheapest way for a compromised package anywhere in it to execute with
# those credentials, on a developer's machine or in CI, before a single line
# of this project's own code runs. `web/` has the same setting for a tree that
# only ever produces static HTML; this one deserves it more.
#
# Four packages in the current lockfile declare install hooks, and every one
# of them ships its platform binary as an optionalDependency instead, which is
# how they keep working without the hook:
#
#   @parcel/watcher  install:     node scripts/build-from-source.js  (12 optional)
#   @swc/core        postinstall: node postinstall.js                (12 optional)
#   esbuild          postinstall: node install.js                    (26 optional)
#   unrs-resolver    postinstall: node postinstall.js                (22 optional)
#
# Verified against the real thing, not against that reasoning: a clean
# `npm ci` from this lockfile with this setting, then
#
#   npm test        -> 2 suites, 9 tests passed   (proves @swc/jest works)
#   npx tsc --noEmit -> clean
#   npx cdk synth    -> full template, us-east-2, with no credentials set
#
# So the deploy path is intact. If a future dependency genuinely needs its
# install hook, prefer pinning that one package over deleting this line.
ignore-scripts=true
